# Copy to keystore.properties (gitignored) and fill in to sign release builds.
# Create the keystore first:
#
#   keytool -genkeypair -v -keystore release.jks -alias workout-tracker \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Keep release.jks and these passwords backed up somewhere safe: lose them and
# you can never update an app published under this key.
storeFile=release.jks
storePassword=
keyAlias=workout-tracker
keyPassword=
